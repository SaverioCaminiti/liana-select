{
  // Tooling config files run in Node: they get Node types, not the DOM.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vite.site.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
